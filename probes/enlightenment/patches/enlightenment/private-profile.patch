--- a/data/config/standard/private-profile.sh
+++ b/data/config/standard/private-profile.sh
@@ -0,0 +1,52 @@
+#!/bin/sh
+# SPDX-License-Identifier: BSD-2-Clause
+# Derive a disposable nested-session profile from the upstream standard profile.
+set -eu
+[ "$#" -eq 2 ] || { echo 'Usage: private-profile.sh INPUT.src OUTPUT.src' >&2; exit 2; }
+awk '
+BEGIN {
+    split("backlight battery bluez5 connman cpufreq geolocation lokker mixer packagekit polkit temperature", names)
+    for (i in names) disabled[names[i]] = 1
+    split("desk_lock halt halt_now reboot suspend suspend_smart suspend_hybrid suspend_then_hibernate hibernate backlight backlight_adjust volume_decrease volume_increase volume_mute", actions)
+    for (i in actions) unavailable[actions[i]] = 1
+}
+function emit_block() {
+    if (!(name in disabled) && !(action in unavailable)) printf "%s", block
+    block = ""
+    name = ""
+    action = ""
+    collecting = 0
+}
+/group "E_Config_(Module|Gadcon_Client|Syscon_Action|Binding_[A-Za-z]+)" struct \{/ {
+    collecting = 1
+    depth = 0
+}
+collecting {
+    block = block $0 "\n"
+    if ($0 ~ /value "name" string: "/) {
+        name = $0
+        sub(/^.*value "name" string: "/, "", name)
+        sub(/";.*/, "", name)
+    }
+    if ($0 ~ /value "action" string: "/) {
+        action = $0
+        sub(/^.*value "action" string: "/, "", action)
+        sub(/";.*/, "", action)
+    }
+    line = $0
+    depth += gsub(/\{/, "{", line)
+    depth -= gsub(/\}/, "}", line)
+    if (depth == 0) emit_block()
+    next
+}
+/value "(desklock_start_locked|desklock_on_suspend|desklock_autolock_screensaver|screensaver_enable|screensaver_suspend|screensaver_hibernate|screensaver_suspend_on_ac|dpms_enable|dpms_standby_enable|dpms_suspend_enable|dpms_off_enable|backlight\.idle_dim|backlight\.ddc)" / {
+    sub(/: [0-9]+;/, ": 0;")
+}
+{ print }
+END {
+    if (collecting) {
+        print "Unterminated profile group" > "/dev/stderr"
+        exit 1
+    }
+}
+' "$1" > "$2"
