diff -ruN a/src/lib/efl/efl_lua_compat.h b/src/lib/efl/efl_lua_compat.h
--- a/src/lib/efl/efl_lua_compat.h	1970-01-01 03:00:00.000000000 +0300
+++ b/src/lib/efl/efl_lua_compat.h	2026-10-06 20:28:32.488988675 +0300
@@ -0,0 +1,34 @@
+#ifndef EFL_LUA_COMPAT_H
+#define EFL_LUA_COMPAT_H
+
+#include <limits.h>
+#include <lua.h>
+#include <lauxlib.h>
+
+/* Lua 5.1/5.2 truncated fractional numbers in lua_tointeger(). Lua 5.3+
+ * requires an exact integer and otherwise returns zero. Edje animations
+ * and Evas filters intentionally accept fractional coordinates and colors.
+ * Preserve their truncation while rejecting undefined C integer conversions.
+ */
+static inline int
+_efl_lua_number_to_int(lua_State *L, lua_Number value)
+{
+   if (!((long double)value > (long double)INT_MIN - 1.0L &&
+         (long double)value < (long double)INT_MAX + 1.0L))
+     return luaL_error(L, "number outside the EFL integer range");
+   return (int)value;
+}
+
+static inline int
+_efl_lua_toint(lua_State *L, int index)
+{
+   return _efl_lua_number_to_int(L, lua_tonumber(L, index));
+}
+
+static inline int
+_efl_lua_checkint(lua_State *L, int index)
+{
+   return _efl_lua_number_to_int(L, luaL_checknumber(L, index));
+}
+
+#endif
