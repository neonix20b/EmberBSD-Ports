+/* Validate the entire result before writing any part of a retained buffer. */
+static bool vrend_query_buffer_fits(const struct vrend_resource *res)
+{
+   size_t remaining = sizeof(struct virgl_host_query_state);
+
+   if (res->base.width0 < remaining)
+      return false;
+   if (!res->iov)
+      return res->ptr != NULL;
+   for (uint32_t i = 0; i < res->num_iovs; i++) {
+      if (res->iov[i].iov_len && !res->iov[i].iov_base)
+         return false;
+      if (res->iov[i].iov_len >= remaining)
+         return true;
+      remaining -= res->iov[i].iov_len;
+   }
+   return false;
+}
