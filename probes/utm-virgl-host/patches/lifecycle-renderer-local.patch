 #define VIRGL_RENDERER_NEPTUNE       (1 << 15)
 
+/* Paired downstream host ABI; requires a renderer built with video=false. */
+#define VIRGL_RENDERER_EMBER_CLASSIC_LIFECYCLE_ABI 1
+VIRGL_EXPORT int virgl_renderer_ember_classic_init_v1(
+   void *cookie, int flags, struct virgl_renderer_callbacks *cbs);
+
 VIRGL_EXPORT int virgl_renderer_init(void *cookie, int flags, struct virgl_renderer_callbacks *cb);
 VIRGL_EXPORT void virgl_renderer_poll(void); /* force fences */
 
