From: EmberBSD Ports contributors
Subject: [LOCAL] Default-off classic VirGL lifecycle foundation

AI-assisted downstream adaptation. Not submitted or accepted upstream.
Preserves upstream license and author notices. Guest ABI unchanged.
Applies after full selected UTM overlay, accepted CREATE and C8c1 backing.

--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -1743,3 +1743,25 @@
 
    return ctx->get_device_fd(ctx);
 }
+
+/* EmberBSD downstream ABI v1, AI-assisted. No guest ABI change. */
+int virgl_renderer_ember_classic_init_v1(void *cookie, int flags,
+                                       struct virgl_renderer_callbacks *cbs)
+{
+#ifdef ENABLE_VIDEO
+   (void)cookie;
+   (void)flags;
+   (void)cbs;
+   return -ENOTSUP;
+#else
+   if (flags & ~VIRGL_RENDERER_NATIVE_SHARE_TEXTURE)
+      return -EINVAL;
+   if (state.client_initialized)
+      return -EBUSY;
+   if (!cbs || cbs->version < 3 || !cbs->write_fence ||
+       !cbs->write_context_fence || !cbs->create_gl_context ||
+       !cbs->destroy_gl_context || !cbs->make_current)
+      return -EINVAL;
+   return virgl_renderer_init(cookie, flags, cbs);
+#endif
+}
--- a/src/virglrenderer.h
+++ b/src/virglrenderer.h
@@ -174,6 +174,11 @@
