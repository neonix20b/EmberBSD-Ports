+/* A reported failure may follow partial guest-backing access.  Preserve it
+ * until the classic lifecycle barrier has stopped every CPU producer and
+ * detached all renderer IOVs; an error response alone is not a revoke. */
+static bool virgl_report_completion_error(VirtIOGPU *g,
+    struct virtio_gpu_ctrl_command *cmd, int ret)
+{
+    if (!ret || !VIRTIO_GPU_GL(g)->ember_classic_lifecycle) {
+        return false;
+    }
+
+    /* Do not negate ret: some backends return negative errno or INT_MIN. */
+    cmd->error = (ret == ENOMEM || ret == -ENOMEM) ?
+        VIRTIO_GPU_RESP_ERR_OUT_OF_MEMORY : VIRTIO_GPU_RESP_ERR_UNSPEC;
+    virtio_gpu_virgl_request_fault(g, cmd, cmd->error);
+    return true;
+}
