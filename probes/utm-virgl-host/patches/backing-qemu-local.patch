+/* Main-loop serialized: keep DMA mappings live through renderer CUSTOM copy. */
+static void detach_classic_backing(struct virtio_gpu_virgl_resource *res)
+{
+    struct iovec *iov = NULL;
+    int count = 0;
+
+    if (res->classic_backing_state != CLASSIC_BACKING_ATTACHED) {
+        return;
+    }
+    virgl_renderer_resource_detach_iov(res->base.resource_id, &iov, &count);
+    if (iov != res->classic_iov || count < 0 ||
+        (uint32_t)count != res->classic_iov_count) {
+        /* A host ownership violation must not complete reset or free DMA. */
+        error_report("virtio-gpu: classic backing detach ownership mismatch");
+        abort();
+    }
+    res->classic_backing_state = CLASSIC_BACKING_DETACHED_RETAINED;
+}
+
+static void release_classic_backing(VirtIOGPU *g,
+                                    struct virtio_gpu_virgl_resource *res)
+{
+    if (res->classic_backing_state == CLASSIC_BACKING_ATTACHED) {
+        error_report("virtio-gpu: releasing attached classic backing");
+        abort();
+    }
+    if (res->classic_backing_state == CLASSIC_BACKING_DETACHED_RETAINED) {
+        virtio_gpu_cleanup_mapping_iov(g, res->classic_iov,
+                                       res->classic_iov_count);
+        res->classic_iov = NULL;
+        res->classic_iov_count = 0;
+        res->classic_backing_state = CLASSIC_BACKING_NONE;
+    }
+}
+
