+/* EmberBSD local, AI-assisted. Main/BQL except admission close from vCPU/BQL. */
+void virtio_gpu_virgl_schedule_lifecycle(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    if (!gl->ember_classic_lifecycle || !gl->handles_ready ||
+        gl->classic_state == CL_DEAD) {
+        return;
+    }
+    qemu_bh_schedule(gl->lifecycle_bh);
+}
+
+static void virtio_gpu_virgl_close_admission(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    if (!gl->handles_ready) {
+        return;
+    }
+    timer_del(gl->fence_poll);
+    if (gl->print_stats) {
+        timer_del(gl->print_stats);
+    }
+    if (gl->cmdq_resume_bh) {
+        qemu_bh_cancel(gl->cmdq_resume_bh);
+    }
+    if (gl->async_fence_bh) {
+        qemu_bh_cancel(gl->async_fence_bh);
+    }
+}
+
+bool virtio_gpu_virgl_cmdq_handoff_allowed(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    if (!gl->ember_classic_lifecycle) {
+        return true;
+    }
+    if (gl->classic_state != CL_RUNNING || gl->reset_requested ||
+        gl->fault_latched || !gl->renderer_live) {
+        virtio_gpu_virgl_schedule_lifecycle(g);
+        return false;
+    }
+    return !gl->renderer_call_depth;
+}
+
+bool virtio_gpu_virgl_cmdq_allowed(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    if (!gl->ember_classic_lifecycle) {
+        return true;
+    }
+    if (!virtio_gpu_virgl_cmdq_handoff_allowed(g)) {
+        return false;
+    }
+    if (!g->processing_cmdq && !gl->renderer_call_depth &&
+        !QSLIST_EMPTY(&gl->async_fenceq)) {
+        qemu_bh_schedule(gl->async_fence_bh);
+    }
+    return !g->parent_obj.renderer_blocked && !gl->renderer_call_depth;
+}
+
+void virtio_gpu_virgl_request_fault(VirtIOGPU *g,
+    struct virtio_gpu_ctrl_command *cmd, uint32_t wire_error)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    if (!gl->ember_classic_lifecycle || gl->reset_requested ||
+        (gl->classic_state != CL_RUNNING &&
+         gl->classic_state != CL_INITIALIZING)) {
+        return;
+    }
+    if (!gl->fault_latched) {
+        gl->fault_latched = true;
+        gl->fault_error = wire_error ? wire_error : VIRTIO_GPU_RESP_ERR_UNSPEC;
+        gl->fault_generation = gl->generation;
+        if (cmd) {
+            cmd->error = gl->fault_error;
+        }
+    }
+    gl->classic_state = CL_FAULT_PENDING;
+    virtio_gpu_virgl_close_admission(g);
+    virtio_gpu_virgl_schedule_lifecycle(g);
+}
+
+void virtio_gpu_virgl_request_reset(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    if (!gl->ember_classic_lifecycle) {
+        return;
+    }
+    /* A synchronous main reset cannot wait for its own renderer call. */
+    if (!qemu_in_vcpu_thread() &&
+        (gl->renderer_call_depth || g->processing_cmdq)) {
+        error_report("virtio-gpu: reentrant classic reset");
+        abort();
+    }
+    gl->reset_requested = true;
+    gl->reset_revoke_done = false;
+    gl->classic_state = CL_REVOKING;
+    virtio_gpu_virgl_close_admission(g);
+}
+
+void virtio_gpu_virgl_terminal_response(VirtIOGPU *g,
+    struct virtio_gpu_ctrl_command *cmd)
+{
+    if (cmd->finished) {
+        return;
+    }
+    if (!cmd->header_valid) {
+        memset(&cmd->cmd_hdr, 0, sizeof(cmd->cmd_hdr));
+        if (iov_to_buf(cmd->elem.out_sg, cmd->elem.out_num, 0,
+                       &cmd->cmd_hdr, sizeof(cmd->cmd_hdr)) !=
+            sizeof(cmd->cmd_hdr)) {
+            memset(&cmd->cmd_hdr, 0, sizeof(cmd->cmd_hdr));
+            cmd->error = VIRTIO_GPU_RESP_ERR_UNSPEC;
+        } else {
+            cmd->header_valid = true;
+        }
+    }
+    virtio_gpu_ctrl_response_nodata(g, cmd,
+        cmd->error ? cmd->error : VIRTIO_GPU_RESP_ERR_UNSPEC);
+}
+
+static void virtio_gpu_virgl_drain_commands(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+    struct virtio_gpu_ctrl_command *cmd;
+
+    while ((cmd = QTAILQ_FIRST(&g->cmdq))) {
+        QTAILQ_REMOVE(&g->cmdq, cmd, next);
+        if (!gl->reset_requested) {
+            virtio_gpu_virgl_terminal_response(g, cmd);
+        }
+        g_free(cmd);
+    }
+    while ((cmd = QTAILQ_FIRST(&g->fenceq))) {
+        QTAILQ_REMOVE(&g->fenceq, cmd, next);
+        g->inflight--;
+        if (!gl->reset_requested) {
+            virtio_gpu_virgl_terminal_response(g, cmd);
+        }
+        g_free(cmd);
+    }
+}
+
+static void virtio_gpu_virgl_revoke(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+    struct virtio_gpu_simple_resource *base;
+    struct virtio_gpu_virgl_resource *res;
+
+    if (gl->renderer_call_depth || g->processing_cmdq) {
+        error_report("virtio-gpu: classic revoke with active CPU producer");
+        abort();
+    }
+    gl->classic_state = CL_REVOKING;
+    virtio_gpu_virgl_close_admission(g);
+    /* Precheck the entire set before any detach, release or response. */
+    if (!QTAILQ_EMPTY(&gl->unmap_done_list) ||
+        !QTAILQ_EMPTY(&g->dmabuf.bufs)) {
+        error_report("virtio-gpu: nonclassic deferred owner at revoke");
+        abort();
+    }
+    QTAILQ_FOREACH(base, &g->reslist, next) {
+        res = container_of(base, struct virtio_gpu_virgl_resource, base);
+        if (!res->classic_backing_managed || base->iov || base->iov_cnt ||
+            base->addrs || base->blob || base->blob_size || base->remapped ||
+            base->dmabuf_fd >= 0 || res->mr ||
+            res->unref_cmd || res->map_blocked ||
+            res->classic_backing_state < CLASSIC_BACKING_NONE ||
+            res->classic_backing_state > CLASSIC_BACKING_DETACHED_RETAINED ||
+            (res->classic_backing_state == CLASSIC_BACKING_NONE &&
+             (res->classic_iov || res->classic_iov_count))) {
+            error_report("virtio-gpu: nonclassic resource owner at revoke");
+            abort();
+        }
+    }
+    /* All renderer CUSTOM copies finish while every guest mapping is live. */
+    gl->renderer_call_depth++;
+    QTAILQ_FOREACH(base, &g->reslist, next) {
+        res = container_of(base, struct virtio_gpu_virgl_resource, base);
+        detach_classic_backing(res);
+    }
+    gl->renderer_call_depth--;
+    QTAILQ_FOREACH(base, &g->reslist, next) {
+        res = container_of(base, struct virtio_gpu_virgl_resource, base);
+        release_classic_backing(g, res);
+    }
+    virtio_gpu_virgl_reset_async_fences(g);
+    gl->classic_state = CL_REVOKED;
+    virtio_gpu_virgl_drain_commands(g);
+}
+
+bool virtio_gpu_virgl_reset_resources(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    if (!gl->ember_classic_lifecycle) {
+        return false;
+    }
+    virtio_gpu_virgl_revoke(g);
+    gl->reset_revoke_done = true;
+    virtio_gpu_virgl_schedule_lifecycle(g);
+    return true;
+}
+
+static void virtio_gpu_virgl_lifecycle_bh(void *opaque)
+{
+    VirtIOGPU *g = opaque;
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+    struct virtio_gpu_simple_resource *res, *tmp;
+
+    /* Outer return or command ownership handoff will schedule again. */
+    if (gl->renderer_call_depth || g->processing_cmdq ||
+        (gl->reset_requested && !gl->reset_revoke_done)) {
+        return;
+    }
+    if (gl->classic_state == CL_FAULT_PENDING) {
+        virtio_gpu_virgl_revoke(g);
+        /* An init callback fault can leave the first descriptor unpopped. */
+        qemu_bh_schedule(g->ctrl_bh);
+    }
+    if (gl->classic_state != CL_REVOKED) {
+        return;
+    }
+    if (gl->renderer_live && g->parent_obj.renderer_blocked) {
+        return;
+    }
+    gl->classic_state = CL_CLEANING;
+    if (gl->renderer_live) {
+        gl->renderer_call_depth++;
+        virtio_gpu_virgl_reset_scanout(g);
+        QTAILQ_FOREACH_SAFE(res, &g->reslist, next, tmp) {
+            virtio_gpu_virgl_resource_destroy(g, res, &error_abort);
+        }
+        virgl_renderer_cleanup(NULL);
+        gl->renderer_call_depth--;
+        gl->renderer_live = false;
+    }
+    if (gl->async_fence_bh) {
+        qemu_bh_cancel(gl->async_fence_bh);
+    }
+    virtio_gpu_virgl_reset_async_fences(g);
+    gl->renderer_state = RS_START;
+    if (gl->reset_requested) {
+        gl->reset_requested = false;
+        gl->reset_revoke_done = false;
+        gl->fault_latched = false;
+        gl->fault_error = 0;
+        gl->classic_state = CL_COLD;
+        qemu_bh_schedule(g->ctrl_bh);
+    } else {
+        gl->classic_state = CL_FAULTED;
+    }
+}
+
+void virtio_gpu_virgl_lifecycle_unrealize(VirtIOGPU *g)
+{
+    VirtIOGPUGL *gl = VIRTIO_GPU_GL(g);
+
+    virtio_gpu_virgl_request_reset(g);
+    virtio_gpu_virgl_reset_resources(g);
+    if (gl->renderer_live && g->parent_obj.renderer_blocked) {
+        error_report("virtio-gpu: blocked classic unrealize after CPU revoke");
+        abort();
+    }
+    virtio_gpu_virgl_lifecycle_bh(g);
+    gl->classic_state = CL_DEAD;
+    qemu_bh_cancel(g->ctrl_bh);
+    if (!gl->handles_ready) {
+        return;
+    }
+    qemu_bh_delete(gl->lifecycle_bh);
+    if (gl->cmdq_resume_bh) {
+        qemu_bh_delete(gl->cmdq_resume_bh);
+    }
+    if (gl->async_fence_bh) {
+        qemu_bh_delete(gl->async_fence_bh);
+    }
+    timer_free(gl->fence_poll);
+    if (gl->print_stats) {
+        timer_free(gl->print_stats);
+    }
+    gl->lifecycle_bh = gl->cmdq_resume_bh = gl->async_fence_bh = NULL;
+    gl->fence_poll = gl->print_stats = NULL;
+    gl->handles_ready = false;
+}
