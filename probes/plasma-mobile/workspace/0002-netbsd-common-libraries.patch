--- a/layer-shell-qt-6.7.5/CMakeLists.txt
+++ b/layer-shell-qt-6.7.5/CMakeLists.txt
@@ -22,6 +22,14 @@
 include(KDEInstallDirs)
 include(KDECMakeSettings)
 include(KDECompilerSettings NO_POLICY_SCOPE)
+
+# NetBSD's libutil emits .gnu.warning notes for exported compatibility aliases.
+# Keep those diagnostics visible and retain KDE's --no-undefined check.
+if(CMAKE_SYSTEM_NAME STREQUAL "NetBSD")
+    string(REPLACE "-Wl,--fatal-warnings" "" CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS}")
+    string(REPLACE "-Wl,--fatal-warnings" "" CMAKE_MODULE_LINKER_FLAGS "${CMAKE_MODULE_LINKER_FLAGS}")
+endif()
+
 include(ECMSetupVersion)
 include(ECMDeprecationSettings)
 include(ECMGenerateHeaders)
