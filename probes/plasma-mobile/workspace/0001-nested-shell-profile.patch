 include(ECMDeprecationSettings)
 include(ECMQmlModule)
 
+option(BUILD_NESTED_SHELL_ONLY "Build the shell and runtime modules for a private nested session" OFF)
+if(BUILD_NESTED_SHELL_ONLY)
