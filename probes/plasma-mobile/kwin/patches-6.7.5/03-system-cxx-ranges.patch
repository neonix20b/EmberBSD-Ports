diff -ruN src/utils/ranges.h src/utils/ranges.h
--- src/utils/ranges.h	1970-01-01 03:00:00.000000000 +0300
+++ src/utils/ranges.h	2026-10-06 21:22:13.659864424 +0300
@@ -0,0 +1,55 @@
+/*
+    SPDX-FileCopyrightText: 2026 EmberBSD contributors
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <ranges>
+#include <utility>
+
+namespace KWin
+{
+
+// Materialize the sequence containers used by KWin with C++20 range support.
+// This keeps builds on NetBSD's system C++ runtime, shared with packaged Qt.
+template<typename Container>
+struct ToContainer
+{
+    template<std::ranges::input_range Range>
+    friend Container operator|(Range &&range, ToContainer)
+    {
+        Container result;
+        if constexpr (std::ranges::sized_range<Range>) {
+            result.reserve(std::ranges::size(range));
+        }
+        for (auto &&value : range) {
+            result.push_back(std::forward<decltype(value)>(value));
+        }
+        return result;
+    }
+};
+
+template<template<typename...> typename Container>
+struct ToTemplateContainer
+{
+    template<std::ranges::input_range Range>
+    friend auto operator|(Range &&range, ToTemplateContainer)
+    {
+        return std::forward<Range>(range) | ToContainer<Container<std::ranges::range_value_t<Range>>>{};
+    }
+};
+
+template<typename Container>
+constexpr auto toContainer()
+{
+    return ToContainer<Container>{};
+}
+
+template<template<typename...> typename Container>
+constexpr auto toContainer()
+{
+    return ToTemplateContainer<Container>{};
+}
+
+} // namespace KWin
