--- a/tests/test-shm.c
+++ b/tests/test-shm.c
@@ -0,0 +1,71 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Shared-memory descriptor contract for Wayland buffers.
+ */
+
+#include "util.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+
+static void
+test_phosh_shm_file (void)
+{
+  const size_t size = 4093; /* Exercise unaligned keymap lengths. */
+  struct stat statbuf;
+  unsigned char *first, *second;
+  int flags;
+  int fd = phosh_create_shm_file (size);
+
+  g_assert_cmpint (fd, >=, 0);
+  flags = fcntl (fd, F_GETFD);
+  g_assert_cmpint (flags, >=, 0);
+  g_assert_true (flags & FD_CLOEXEC);
+  g_assert_cmpint (fstat (fd, &statbuf), ==, 0);
+  /* Some shm implementations round the allocation up to a page. */
+  g_assert_cmpint (statbuf.st_size, >=, size);
+
+  first = mmap (NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  second = mmap (NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  g_assert_true (first != MAP_FAILED);
+  g_assert_true (second != MAP_FAILED);
+  g_assert_cmpint (first[0], ==, 0);
+  g_assert_cmpint (second[size - 1], ==, 0);
+
+  first[0] = 23;
+  second[size - 1] = 42;
+  g_assert_cmpint (second[0], ==, 23);
+  g_assert_cmpint (first[size - 1], ==, 42);
+
+  g_assert_cmpint (close (fd), ==, 0);
+  g_assert_cmpint (first[size - 1], ==, 42);
+  g_assert_cmpint (munmap (first, size), ==, 0);
+  g_assert_cmpint (munmap (second, size), ==, 0);
+}
+
+
+static void
+test_phosh_shm_invalid_size (void)
+{
+  int fd;
+
+  errno = 0;
+  fd = phosh_create_shm_file (-1);
+  g_assert_cmpint (fd, ==, -1);
+  g_assert_cmpint (errno, ==, EINVAL);
+}
+
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/phosh/shm/file", test_phosh_shm_file);
+  g_test_add_func ("/phosh/shm/invalid-size", test_phosh_shm_invalid_size);
+  return g_test_run ();
+}
