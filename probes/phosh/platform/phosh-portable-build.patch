--- a/tests/test-backlight.c
+++ b/tests/test-backlight.c
@@ -0,0 +1,116 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Test backend for the Phosh backlight brightness conversion.
+ */
+
+#include "backlight-priv.h"
+
+typedef struct {
+  PhoshBacklight parent;
+  int level;
+} TestBacklight;
+
+typedef PhoshBacklightClass TestBacklightClass;
+
+G_DEFINE_TYPE (TestBacklight, test_backlight, PHOSH_TYPE_BACKLIGHT)
+
+
+static void
+test_backlight_set_level (PhoshBacklight      *backlight,
+                         int                  level,
+                         GCancellable        *cancellable,
+                         GAsyncReadyCallback  callback,
+                         gpointer             user_data)
+{
+  TestBacklight *self = (TestBacklight *) backlight;
+  g_autoptr (GTask) task = g_task_new (backlight, cancellable, callback, user_data);
+
+  self->level = level;
+  g_task_return_int (task, level);
+}
+
+
+static int
+test_backlight_set_level_finish (PhoshBacklight  *backlight,
+                                GAsyncResult    *result,
+                                GError         **error)
+{
+  g_assert_true (g_task_is_valid (result, backlight));
+  return g_task_propagate_int (G_TASK (result), error);
+}
+
+
+static void
+test_backlight_class_init (TestBacklightClass *klass)
+{
+  klass->set_level = test_backlight_set_level;
+  klass->set_level_finish = test_backlight_set_level_finish;
+}
+
+
+static void
+test_backlight_init (TestBacklight *self)
+{
+  self->level = -1;
+}
+
+
+static void
+assert_relative_level (TestBacklight *self, double relative, int expected)
+{
+  phosh_backlight_set_relative (PHOSH_BACKLIGHT (self), relative);
+  while (g_main_context_iteration (NULL, FALSE));
+  g_assert_cmpint (self->level, ==, expected);
+  g_assert_cmpfloat_with_epsilon (phosh_backlight_get_relative (PHOSH_BACKLIGHT (self)),
+                                relative, 0.000001);
+}
+
+
+static void
+test_phosh_backlight_linear (void)
+{
+  TestBacklight *self = g_object_new (test_backlight_get_type (), NULL);
+  PhoshBacklight *backlight = PHOSH_BACKLIGHT (self);
+
+  phosh_backlight_set_range (backlight, 1, 10000, PHOSH_BACKLIGHT_SCALE_LINEAR);
+  assert_relative_level (self, 0.0, 1);
+  assert_relative_level (self, 0.25, 10);
+  assert_relative_level (self, 0.5, 100);
+  assert_relative_level (self, 0.75, 1000);
+  assert_relative_level (self, 1.0, 10000);
+
+  /* A fractional exponent must round the hardware level, not the exponent. */
+  phosh_backlight_set_brightness (backlight, 1.25);
+  while (g_main_context_iteration (NULL, FALSE));
+  g_assert_cmpint (self->level, ==, 18);
+
+  phosh_backlight_backend_update_level (backlight, 100);
+  g_assert_cmpfloat_with_epsilon (phosh_backlight_get_relative (backlight), 0.5, 0.000001);
+  g_object_unref (self);
+}
+
+
+static void
+test_phosh_backlight_non_linear (void)
+{
+  TestBacklight *self = g_object_new (test_backlight_get_type (), NULL);
+
+  phosh_backlight_set_range (PHOSH_BACKLIGHT (self), 1, 101, PHOSH_BACKLIGHT_SCALE_NON_LINEAR);
+  assert_relative_level (self, 0.0, 1);
+  assert_relative_level (self, 0.25, 26);
+  assert_relative_level (self, 0.5, 51);
+  assert_relative_level (self, 0.75, 76);
+  assert_relative_level (self, 1.0, 101);
+  g_object_unref (self);
+}
+
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/phosh/backlight/linear", test_phosh_backlight_linear);
+  g_test_add_func ("/phosh/backlight/non-linear", test_phosh_backlight_non_linear);
+  return g_test_run ();
+}
--- a/tests/test-shm.c
+++ b/tests/test-shm.c
@@ -0,0 +1,71 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Shared-memory descriptor contract for Wayland buffers.
+ */
+
+#include "util.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+
+static void
+test_phosh_shm_file (void)
+{
+  const size_t size = 4096;
+  struct stat statbuf;
+  unsigned char *first, *second;
+  int flags;
+  int fd = phosh_create_shm_file (size);
+
+  g_assert_cmpint (fd, >=, 0);
+  flags = fcntl (fd, F_GETFD);
+  g_assert_cmpint (flags, >=, 0);
+  g_assert_true (flags & FD_CLOEXEC);
+  g_assert_cmpint (fstat (fd, &statbuf), ==, 0);
+  /* Some shm implementations round the allocation up to a page. */
+  g_assert_cmpint (statbuf.st_size, >=, size);
+
+  first = mmap (NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  second = mmap (NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  g_assert_true (first != MAP_FAILED);
+  g_assert_true (second != MAP_FAILED);
+  g_assert_cmpint (first[0], ==, 0);
+  g_assert_cmpint (second[size - 1], ==, 0);
+
+  first[0] = 23;
+  second[size - 1] = 42;
+  g_assert_cmpint (second[0], ==, 23);
+  g_assert_cmpint (first[size - 1], ==, 42);
+
+  g_assert_cmpint (close (fd), ==, 0);
+  g_assert_cmpint (first[size - 1], ==, 42);
+  g_assert_cmpint (munmap (first, size), ==, 0);
+  g_assert_cmpint (munmap (second, size), ==, 0);
+}
+
+
+static void
+test_phosh_shm_invalid_size (void)
+{
+  int fd;
+
+  errno = 0;
+  fd = phosh_create_shm_file (-1);
+  g_assert_cmpint (fd, ==, -1);
+  g_assert_cmpint (errno, ==, EINVAL);
+}
+
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/phosh/shm/file", test_phosh_shm_file);
+  g_test_add_func ("/phosh/shm/invalid-size", test_phosh_shm_invalid_size);
+  return g_test_run ();
+}
