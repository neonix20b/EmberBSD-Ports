--- /dev/null
+++ b/src/ui/no-network.xsl
@@ -0,0 +1,21 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<!-- Remove controls whose backends are not built; do not invent connectivity. -->
+<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
+  <xsl:output method="xml" encoding="UTF-8"/>
+  <xsl:template match="@*|node()">
+    <xsl:copy><xsl:apply-templates select="@*|node()"/></xsl:copy>
+  </xsl:template>
+  <xsl:template match="object[@class='PhoshWifiInfo' or @class='PhoshWWanInfo' or
+                              @class='PhoshVpnInfo' or @class='PhoshConnectivityInfo' or
+                              @class='PhoshWifiStatusPage']"/>
+  <xsl:template match="child[object/property[(@name='child' or @name='status-icon') and
+                                      (.='wifiinfo' or .='wwaninfo' or .='vpninfo' or
+                                       .='vpn_info' or .='connectivity_info')]]"/>
+  <xsl:template match="file[.='ui/quick-settings.ui']">
+    <file preprocess="xml-stripblanks" alias="ui/quick-settings.ui">quick-settings-no-network.ui</file>
+  </xsl:template>
+  <xsl:template match="file[.='ui/top-panel.ui']">
+    <file preprocess="xml-stripblanks" alias="ui/top-panel.ui">top-panel-no-network.ui</file>
+  </xsl:template>
+</xsl:stylesheet>
