Return G_IO_ERROR_NOT_SUPPORTED when the platform has no wakeup timer clock.
Exercise the documented error return; do not replace the wakeup clock.
Origin: Local EmberBSD portability changes, AI-assisted, 2026-10-06.
Status: Not submitted to or accepted by upstream.

--- a/src/gm-timeout.c
+++ b/src/gm-timeout.c
@@ -110,8 +110,10 @@
   switch (clockid) {
   case CLOCK_BOOTTIME:
     return "[gm] boottime timeout source";
+#ifdef CLOCK_BOOTTIME_ALARM
   case CLOCK_BOOTTIME_ALARM:
     return "[gm] boottime wakeup timeout source";
+#endif
   default:
     g_assert_not_reached();
     return "";
@@ -272,6 +274,11 @@
 
   g_return_val_if_fail (function != NULL, 0);
 
+#ifndef CLOCK_BOOTTIME_ALARM
+  g_set_error_literal (err, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                       "Wakeup timers are not supported on this platform");
+  return 0;
+#else
   source = gm_timeout_source_once_new (1000L * seconds, CLOCK_BOOTTIME_ALARM, err);
   if (!source)
     return 0;
@@ -283,6 +290,7 @@
   id = g_source_attach (source, NULL);
 
   return id;
+#endif
 }
 
