+// AI-assisted EmberBSD extraction of the unavailable-pose history branch.
+#ifndef ORB_SLAM3_TRACKING_HISTORY_H
+#define ORB_SLAM3_TRACKING_HISTORY_H
+#include <list>
+#include <sophus/se3.hpp>
+
+namespace ORB_SLAM3 {
+class KeyFrame;
+
+inline void AppendUnavailableFrame(std::list<Sophus::SE3f> &poses,
+    std::list<KeyFrame *> &references, std::list<double> &timestamps,
+    std::list<bool> &lost, double current_timestamp)
+{
+    // Retain aligned list entries without claiming a previous pose is current.
+    poses.push_back(poses.back());
+    references.push_back(references.back());
+    timestamps.push_back(current_timestamp);
+    lost.push_back(true);
+}
+}
+#endif
