Select OSQP's existing POSIX signal listener on NetBSD.

OSQP_ENABLE_INTERRUPT is enabled, but the upstream source list omits the
listener on NetBSD. This preserves signal handling without defining IS_LINUX
or substituting stubs. Original AI-assisted EmberBSD change; not submitted
upstream. The affected source retains its Apache-2.0 license.

--- src/CMakeLists.txt.orig
+++ src/CMakeLists.txt
@@ -66,7 +66,7 @@
 if(OSQP_ENABLE_INTERRUPT AND NOT OSQP_CUSTOM_INTERRUPT)
   if(IS_WINDOWS)
     target_sources(OSQPLIB PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/interrupt_windows.c")
-  elseif(IS_MAC OR IS_LINUX)
+  elseif(IS_MAC OR IS_LINUX OR CMAKE_SYSTEM_NAME STREQUAL "NetBSD")
     target_sources(OSQPLIB PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/interrupt_unix.c")
   endif()
 endif()
