@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * EmberBSD, AI-assisted source-probe adaptation; not a native device ABI.
+ * Encoding and integer types follow Linux v6.12, commit
+ * adc218676eef25575469234709c2d87185ca223a:
+ * include/uapi/asm-generic/{ioctl.h,int-ll64.h}.
+ * Preserve the paired Compass 6.1.1 Linux/AArch64 wire numbers. Do not
+ * use NetBSD _IO* here: its size/direction encoding and transport differ.
+ * No global _IO* macros are defined or replaced by this header.
+ */
+#ifndef ARMCHINA_AIPU_LINUX_UAPI_H
+#define ARMCHINA_AIPU_LINUX_UAPI_H
+#if !defined(__NetBSD__) || !defined(__aarch64__) || \
+    __SIZEOF_POINTER__ != 8 || __SIZEOF_LONG_LONG__ != 8 || \
+    __SIZEOF_INT__ != 4 || __SIZEOF_SHORT__ != 2 || \
+    __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error "Compass source probe supports only NetBSD little-endian AArch64 LP64"
+#endif
+
+typedef unsigned char __u8;
+typedef unsigned short __u16;
+typedef unsigned int __u32;
+typedef unsigned long long __u64;
+typedef signed int __s32;
+typedef signed long long __s64;
+
+#define ARMCHINA_LINUX_IOC(dir, type, nr, size) \
+    (((dir) << 30) | ((type) << 8) | (nr) | ((size) << 16))
+#define ARMCHINA_LINUX_IO(type, nr) ARMCHINA_LINUX_IOC(0U, (type), (nr), 0U)
+#define ARMCHINA_LINUX_IOR(type, nr, t) ARMCHINA_LINUX_IOC(2U, (type), (nr), sizeof(t))
+#define ARMCHINA_LINUX_IOW(type, nr, t) ARMCHINA_LINUX_IOC(1U, (type), (nr), sizeof(t))
+#define ARMCHINA_LINUX_IOWR(type, nr, t) ARMCHINA_LINUX_IOC(3U, (type), (nr), sizeof(t))
+#endif
