+/* See expr.h.  */
+
+value *
+dwarf_expr_context::read_register (int dwarf_reg, type *type)
+{
+  ensure_have_frame (this->m_frame, "DW_OP_entry_value register");
+  gdbarch *arch = get_frame_arch (this->m_frame);
+  if (!this->m_entry_value)
+    return value_from_register
+      (type, dwarf_reg_to_regnum_or_error (arch, dwarf_reg), this->m_frame);
+
+  /* Isolate call-site evaluation from the expression consuming this
+     register.  In particular, do not let it consume the operand stack.  */
+  dwarf_expr_context ctx (this->m_per_objfile, this->m_addr_size);
+  ctx.m_frame = this->m_frame;
+  ctx.m_per_cu = this->m_per_cu;
+  ctx.m_recursion_depth = this->m_recursion_depth;
+  ctx.m_max_recursion_depth = this->m_max_recursion_depth;
+  call_site_parameter_u kind_u;
+  kind_u.dwarf_reg = dwarf_reg;
+  ctx.push_dwarf_reg_entry_value (CALL_SITE_PARAMETER_DWARF_REG, kind_u, -1);
+  if (ctx.m_stack.size () != 1 || !ctx.m_pieces.empty ()
+      || (ctx.m_location != DWARF_VALUE_MEMORY
+          && ctx.m_location != DWARF_VALUE_STACK))
+    error (_("DW_OP_entry_value: call value must produce exactly one value"));
+
+  /* Call values describe register bits.  Preserve them for regval_type,
+     including floating-point base types, rather than converting numerically.  */
+  value *result = ctx.fetch (0);
+  auto contents = result->contents ();
+  if (type->length () > contents.size ())
+    throw_error (NO_ENTRY_VALUE_ERROR,
+                 _("DW_OP_entry_value: complete entry register is unavailable"));
+  size_t offset = (gdbarch_byte_order (arch) == BFD_ENDIAN_BIG
+                   ? contents.size () - type->length () : 0);
+  return value_from_contents (type, contents.data () + offset);
+}
+
+/* See expr.h.  */
+
+value *
+dwarf_expr_context::entry_value (gdb::array_view<const gdb_byte> expr)
+{
+  dwarf_expr_context ctx (this->m_per_objfile, this->m_addr_size);
+  ctx.m_frame = this->m_frame;
+  ctx.m_per_cu = this->m_per_cu;
+  ctx.m_recursion_depth = this->m_recursion_depth;
+  ctx.m_max_recursion_depth = this->m_max_recursion_depth;
+  ctx.m_entry_value = !trivial_entry_value (this->m_frame);
+  ctx.m_in_entry_value = true;
+
+  /* Preserve the existing call_data_value reconstruction.  General memory
+     reads have no entry snapshot and must not read the current inferior.  */
+  CORE_ADDR deref_size;
+  call_site_parameter_u kind_u;
+  kind_u.dwarf_reg = dwarf_block_to_dwarf_reg_deref (expr, &deref_size);
+  if (ctx.m_entry_value && kind_u.dwarf_reg != -1)
+    ctx.push_dwarf_reg_entry_value (CALL_SITE_PARAMETER_DWARF_REG, kind_u,
+                                   deref_size == -1 ? m_addr_size : deref_size);
+  else
+    ctx.eval (expr);
+
+  if (ctx.m_stack.size () != 1 || !ctx.m_pieces.empty ())
+    error (_("DW_OP_entry_value: operand must produce exactly one value"));
+  if (ctx.m_location == DWARF_VALUE_REGISTER)
+    return ctx.read_register (value_as_long (ctx.fetch (0)), address_type ());
+  if (ctx.m_location != DWARF_VALUE_MEMORY
+      && ctx.m_location != DWARF_VALUE_STACK)
+    error (_("DW_OP_entry_value: operand must produce exactly one value"));
+  return ctx.fetch (0);
+}
