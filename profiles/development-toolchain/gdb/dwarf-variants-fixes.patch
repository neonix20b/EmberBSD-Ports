+dwarf_expr_context::dwarf_call_ref (sect_offset die_sect_off)
+{
+  ensure_have_per_cu (this->m_per_cu, "DW_OP_call_ref");
+  frame_info_ptr frame = this->m_frame;
+  auto get_pc_from_frame = [frame] ()
+    {
+      ensure_have_frame (frame, "DW_OP_call_ref");
+      return get_frame_address_in_block (frame);
+    };
+
+  dwarf2_locexpr_baton block
+    = dwarf2_fetch_die_loc_sect_off (die_sect_off, this->m_per_cu,
+				     this->m_per_objfile, get_pc_from_frame);
+  scoped_restore save_per_cu
+    = make_scoped_restore (&this->m_per_cu, block.per_cu);
+  scoped_restore save_per_objfile
+    = make_scoped_restore (&this->m_per_objfile, block.per_objfile);
+  scoped_restore save_addr_size
+    = make_scoped_restore (&this->m_addr_size, block.per_cu->addr_size ());
+  this->eval (block.expr ());
+}
