From 823a3b483b7ffeb73973f911458d6ba22c74efc4 Mon Sep 17 00:00:00 2001
From: wiz <wiz@pkgsrc.org>
Date: Sat, 26 Sep 2026 12:39:53 +0000
Subject: [PATCH] gcc16*: update to 16.2.0

Bugfix release.
---
 lang/gcc16-libjit/Makefile | 3 +--
 lang/gcc16-libs/Makefile   | 4 ++--
 lang/gcc16/Makefile        | 4 ++--
 lang/gcc16/distinfo        | 8 ++++----
 lang/gcc16/version.mk      | 4 ++--
 5 files changed, 11 insertions(+), 12 deletions(-)

diff --git a/lang/gcc16-libjit/Makefile b/lang/gcc16-libjit/Makefile
index 1a36a3aaab4c..e627e15f6bb4 100644
--- a/lang/gcc16-libjit/Makefile
+++ b/lang/gcc16-libjit/Makefile
@@ -1,9 +1,8 @@
-# $NetBSD: Makefile,v 1.2 2026/08/31 18:05:08 wiz Exp $
+# $NetBSD: Makefile,v 1.3 2026/09/26 12:39:53 wiz Exp $
 
 .include "../../lang/gcc16/Makefile.common"
 
 PKGNAME=	${GCC_PKGNAME}-libjit-${GCC16_DIST_VERSION}
-PKGREVISION=	1
 COMMENT=	GNU Compiler Collection 16 (gcclibjit library)
 
 # /usr/bin/ld: ./../intl/libintl.a(bindtextdom.o): relocation R_X86_64_32 against symbol `libintl_nl_default_dirname' can not be used when making a shared object; recompile with -fPIC
diff --git a/lang/gcc16-libs/Makefile b/lang/gcc16-libs/Makefile
index 742158ac138a..dd910672507d 100644
--- a/lang/gcc16-libs/Makefile
+++ b/lang/gcc16-libs/Makefile
@@ -1,4 +1,4 @@
-# $NetBSD: Makefile,v 1.2 2026/08/31 18:05:08 wiz Exp $
+# $NetBSD: Makefile,v 1.3 2026/09/26 12:39:53 wiz Exp $
 
 GCC_PKGNAME=	gcc16
 .include	"../../lang/${GCC_PKGNAME}/version.mk"
@@ -9,7 +9,7 @@ PKGNAME=	${GCC_PKGNAME}-libs-${GCC16_DIST_VERSION}
 ## The PKGREVISION of this package needs to be at least 1 more than the
 ## PKGREVISION of the lang/gcc16 package so that with the dependence pattern
 ## '{gcc16,gcc16-libs}>=16.1.*' pkg_add will choose gcc16-libs over gcc16.
-PKGREVISION=	2
+PKGREVISION=	1
 
 CATEGORIES=	lang
 MASTER_SITES=	# empty
diff --git a/lang/gcc16/Makefile b/lang/gcc16/Makefile
index 284abbbbb60a..ca39161eebc1 100644
--- a/lang/gcc16/Makefile
+++ b/lang/gcc16/Makefile
@@ -1,10 +1,10 @@
-# $NetBSD: Makefile,v 1.2 2026/08/31 18:05:08 wiz Exp $
+# $NetBSD: Makefile,v 1.3 2026/09/26 12:39:53 wiz Exp $
 
 PKGNAME=	${GCC_PKGNAME}-${GCC16_DIST_VERSION}
 ## When bumping the PKGREVISION of this package the PKGREVISION of
 ## lang/gcc16-libs needs to be bumped to be at least 1 more than the
 ## PKGREVISION of this package!
-PKGREVISION=	1
+#PKGREVISION=	1
 COMMENT=	The GNU Compiler Collection (GCC) - 16.0 Release Series
 
 LANGS=		c
diff --git a/lang/gcc16/distinfo b/lang/gcc16/distinfo
index f071e0fba2ed..960cc9e13532 100644
--- a/lang/gcc16/distinfo
+++ b/lang/gcc16/distinfo
@@ -1,8 +1,8 @@
-$NetBSD: distinfo,v 1.3 2026/09/16 13:12:46 wiz Exp $
+$NetBSD: distinfo,v 1.4 2026/09/26 12:39:53 wiz Exp $
 
-BLAKE2s (gcc-16.1.0.tar.xz) = 037fe6c26509be014b26e0c16b07c2faac0c9894491b4525582d45ff88c66970
-SHA512 (gcc-16.1.0.tar.xz) = b3454958891ab47e1e5b6cb9396c0ad3b04f32fe2a7bf1153a143f21013fdb6b295ca94c98964698a688e4c1d7555ffd8ffbc20187507cce6b1c32cbcc09897a
-Size (gcc-16.1.0.tar.xz) = 102456900 bytes
+BLAKE2s (gcc-16.2.0.tar.xz) = b2a4b0c96c7025de8336afaa77eb1c7ce61021110dcf8d3ada3cd064830e5afa
+SHA512 (gcc-16.2.0.tar.xz) = c51c30ca7422d0cbecf504b2e0f33c3aca31e0f90a76b65217f465163fa6fa17b3f5de39e145c47e5bab90ac0ce7fff3b03c8d553ae36e01faaea5a50f8648d1
+Size (gcc-16.2.0.tar.xz) = 107200820 bytes
 BLAKE2s (isl-0.24.tar.xz) = a3013b0d39b7fe68a1b3e15dc7e925b347d555348ee946a80f5319a76973cd61
 SHA512 (isl-0.24.tar.xz) = ff6bdcff839e1cd473f2a0c1e4dd4a3612ec6fee4544ccbc62b530a7248db2cf93b4b99bf493a86ddf2aba00e768927265d5d411f92061ea85fd7929073428e8
 Size (isl-0.24.tar.xz) = 1930956 bytes
diff --git a/lang/gcc16/version.mk b/lang/gcc16/version.mk
index 54c42c4682be..f2f208786046 100644
--- a/lang/gcc16/version.mk
+++ b/lang/gcc16/version.mk
@@ -1,3 +1,3 @@
-# $NetBSD: version.mk,v 1.1 2026/08/10 21:41:34 wiz Exp $
+# $NetBSD: version.mk,v 1.2 2026/09/26 12:39:53 wiz Exp $
 
-GCC16_DIST_VERSION:=	16.1.0
+GCC16_DIST_VERSION:=	16.2.0
