diff -ruN a/lang/tcl-expect/patches/patch-tests_all.tcl b/lang/tcl-expect/patches/patch-tests_all.tcl
--- a/lang/tcl-expect/patches/patch-tests_all.tcl	1970-01-01 03:00:00.000000000 +0300
+++ b/lang/tcl-expect/patches/patch-tests_all.tcl	2026-10-06 23:47:55.987789815 +0300
@@ -0,0 +1,24 @@
+EmberBSD local, AI-assisted; not submitted upstream.
+Propagate failed tests and test-file loading errors to the package driver.
+
+--- tests/all.tcl.orig
++++ tests/all.tcl
+@@ -12,13 +12,16 @@
+ set ::tcltest::testSingleFile false
+ set ::tcltest::testsDirectory [file dirname [info script]]
+ 
++set source_errors 0
+ foreach file [lsort [::tcltest::getMatchingFiles]] {
+     set tail [file tail $file]
+     puts stdout $tail
+     if {[catch {source $file} msg]} {
+ 	puts stdout $msg
++        incr source_errors
+     }
+ }
+ 
+-::tcltest::cleanupTests 1 
+-return
++set failed $::tcltest::numTests(Failed)
++::tcltest::cleanupTests 1
++exit [expr {$failed != 0 || $source_errors != 0}]
